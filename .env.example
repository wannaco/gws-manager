# ── GWS Admin environment ──
# Copy to .env and adjust:  cp .env.example .env

# Encrypts the Google service-account key at rest.
# REQUIRED for production. Generate with:  openssl rand -hex 32
#
# Keep this value safe and back it up: it is the only way to read back a stored
# service-account key. Losing it means re-uploading the key.
ENCRYPTION_KEY=

# Optional. If set, only this exact origin may call the API cross-origin.
# Same-origin requests work regardless, so leave blank unless you embed the UI
# on another domain. Example: https://gws.example.com
GWS_ALLOWED_ORIGIN=
