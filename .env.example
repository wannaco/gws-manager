# ── GWS Manager environment ──
# Copy to .env and adjust:   cp .env.example .env
#
# The first two are REQUIRED by docker-compose.yml and it fails immediately
# without them, on purpose: neither has a safe default. The rest are optional.

# ── The hostname this instance will be served on ──
# Required by docker-compose.yml (the bundled Caddy proxy needs it). Not used by
# docker-compose.dev.yml, and not used behind your own reverse proxy.
#
# Must already resolve to this server (an A/AAAA record), and ports 80 + 443 must
# be reachable from the internet so Caddy can obtain a certificate.
# Example: gws.example.com
GWS_DOMAIN=


# ── Encrypts the Google service-account key at rest ──
# Generate once:   openssl rand -hex 32
#
# This is a credential, not a setting you can regenerate:
#   * BACK IT UP, in a password manager or secrets vault, not only on the server.
#   * REUSE the same value for every future update, restore, or move. Replacing
#     it does not fail loudly — the app starts, looks healthy, and every Google
#     call fails because the stored key can no longer be decrypted.
#   * Losing it means re-uploading the Google service-account JSON.
ENCRYPTION_KEY=


# ── Optional: restrict cross-origin API access to one origin ──
# Same-origin requests work regardless, so leave blank unless you embed the UI on
# another domain. Example: https://gws.example.com
GWS_ALLOWED_ORIGIN=


# ── Optional, bare metal only: which address PocketBase binds ──
# scripts/start.sh sources this file, and defaults to 127.0.0.1:8090 so the admin
# UI is never on your network unencrypted. Point a reverse proxy at it.
#
# Only change this if you deliberately want direct exposure — 0.0.0.0:8090 puts
# the unencrypted admin panel on every interface. Do not do that on a shared or
# untrusted network.
# GWS_BIND=0.0.0.0:8090
